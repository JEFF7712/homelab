{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":separateMultipleMajorReleases",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone"
  ],
  "gitAuthor": "Renovate Bot <bot@renovateapp.com>",
  "major": {
    "enabled": true
  },
  "labels": [
    "renovate",
    "dependencies",
    "automated"
  ],
  "assignees": [
    "jeff7712"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "useBaseBranchConfig": "merge",
  "ignorePaths": [
    "registry/**",
    "schemas/**",
    "artifacts/**",
    "secrets/**",
    ".gitlab-ci.yml"
  ],
  "printConfig": false,
  "branchTopic": "{{{depNameSanitized}}}-{{{newVersion}}}{{#if isLockfileUpdate}}-lockfile{{/if}}",
  "commitMessagePrefix": "renovate:",
  "commitMessageAction": "Bump",
  "commitMessageExtra": "from {{{currentVersion}}} to {{{newVersion}}}",
  "flux": {
    "fileMatch": [
      "^gitops/.+\\.ya?ml$"
    ]
  },
  "kubernetes": {
    "fileMatch": [
      "^gitops/.+\\.ya?ml$"
    ]
  },
  "terraform": {
    "fileMatch": [
      "^tofu/.+\\.tf$"
    ]
  },
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Group GitLab CI and Dockerfile image updates",
      "matchManagers": [
        "dockerfile",
        "gitlabci"
      ],
      "groupName": "CI and Docker image updates",
      "groupSlug": "ci-docker-images"
    },
    {
      "description": "Group OpenTofu provider updates; CI installs providers only from the Nix mirror, so each bump regenerates nix/ci-providers.json",
      "matchManagers": [
        "terraform"
      ],
      "groupName": "OpenTofu dependency updates",
      "groupSlug": "opentofu-dependencies",
      "postUpgradeTasks": {
        "commands": [
          "python3 scripts/ci/sync_providers.py"
        ],
        "fileFilters": [
          "nix/ci-providers.json"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "Group Nix Flake inputs updates",
      "matchManagers": [
        "nix"
      ],
      "groupName": "Nix flake updates",
      "groupSlug": "nix-flake-updates"
    },
    {
      "description": "Automatically merge minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Never automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Never automerge container image updates in GitOps manifests; manual review and registry mirroring required",
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "flux",
        "kubernetes",
        "dockerfile",
        "gitlabci"
      ],
      "automerge": false
    },
    {
      "description": "Review every Helm chart bump: post-renderers pin the app images, so the chart and its mirrored image digests move together by hand (docs/runbooks/local-registry.md)",
      "matchManagers": [
        "flux"
      ],
      "matchDatasources": [
        "helm"
      ],
      "automerge": false
    },
    {
      "description": "Chart image declarations move with their chart's upgrade, never on their own",
      "matchFileNames": [
        "gitops/cert-manager/registry-sources.yaml",
        "gitops/observability/registry-sources.yaml",
        "gitops/platform/registry-sources.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Lock maintenance is for the Nix flakes only; uv and provider locks move with their dependency updates",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchManagers": [
        "pep621",
        "terraform"
      ],
      "enabled": false
    },
    {
      "description": "Node majors for producer base images need a new node-toolchain supply and catalog pins first (docs/runbooks/node-supply.md); a base-image bump alone fails the registry gate",
      "matchFileNames": [
        "gitops/producer-base-images/**"
      ],
      "matchPackageNames": [
        "/(^|/)node$/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Python release images, bus-display and led-matrix pin python 3.12 by digest outside this file, so a newer minor here would only mirror an image nothing builds from; move them together (3.12 is supported until 2028-10)",
      "matchFileNames": [
        "gitops/producer-base-images/**"
      ],
      "matchPackageNames": [
        "/(^|/)python$/"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Flux system upgrades regenerate gotk-components.yaml and mirror its controller images (docs/runbooks/local-registry.md); the Renovate image has no flux binary, so it could only bump the version comment",
      "matchManagers": [
        "flux"
      ],
      "matchFileNames": [
        "gitops/clusters/*/flux-system/gotk-components.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Never automerge Nix inputs: a merged flake bump is undeployed fleet drift until deploy-fleet runs, and nixpkgs can carry a k3s minor upgrade",
      "matchManagers": [
        "nix"
      ],
      "automerge": false
    }
  ]
}

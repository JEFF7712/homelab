{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":separateMultipleMajorReleases",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone"
  ],
  "gitAuthor": "Renovate Bot <bot@renovateapp.com>",
  "major": {
    "enabled": true
  },
  "labels": [
    "renovate",
    "dependencies",
    "automated"
  ],
  "assignees": [
    "jeff7712"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "useBaseBranchConfig": "merge",
  "ignorePaths": [
    "infrastructure/predmarkbot/src/**"
  ],
  "printConfig": false,
  "branchTopic": "{{{depNameSanitized}}}-{{{newVersion}}}{{#if isLockfileUpdate}}-lockfile{{/if}}",
  "commitMessagePrefix": "renovate:",
  "commitMessageAction": "Bump",
  "commitMessageExtra": "from {{{currentVersion}}} to {{{newVersion}}}",
  "kubernetes": {
    "managerFilePatterns": [
      "/^(apps|bootstrap|infrastructure|secrets)/.*\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.gitlab-ci\\.yml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*CI_IMAGE_TAG:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "infrastructure/predmarkbot/deployment\\.yaml$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+image:\\s+\\S+:(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group GitLab CI and Dockerfile image updates",
      "matchManagers": [
        "dockerfile",
        "gitlabci"
      ],
      "groupName": "CI and Docker image updates",
      "groupSlug": "ci-docker-images"
    },
    {
      "description": "Group Terraform provider and module updates",
      "matchManagers": [
        "terraform"
      ],
      "groupName": "Terraform dependency updates",
      "groupSlug": "terraform-dependencies"
    },
    {
      "description": "Group Argo CD tracked Helm chart updates",
      "matchManagers": [
        "argocd"
      ],
      "groupName": "Argo CD Helm chart updates",
      "groupSlug": "argocd-helm-charts"
    },
    {
      "description": "Group Kubernetes manifest image updates",
      "matchManagers": [
        "kubernetes"
      ],
      "groupName": "Kubernetes image updates",
      "groupSlug": "kubernetes-images"
    },
    {
      "description": "Bookshelf publishes parallel softcover-/hardcover- tag streams that Renovate can't auto-parse; restrict to softcover- and provide a regex versioning scheme",
      "matchPackageNames": [
        "ghcr.io/pennydreadful/bookshelf"
      ],
      "versioning": "regex:^softcover-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?$",
      "allowedVersions": "/^softcover-/"
    },
    {
      "description": "Throttle the CI_IMAGE_TAG bump (driven by the customManager above) to weekly Sunday nights — belt-and-suspenders since the .gitlab-ci.yml→build_ci_image feedback loop is already broken by removing .gitlab-ci.yml from build_ci_image's change rules.",
      "matchPackageNames": [
        "jeff7712/homelab-ci"
      ],
      "schedule": [
        "before 6am on sunday"
      ],
      "groupName": "CI image tag",
      "groupSlug": "ci-image-tag"
    },
    {
      "description": "Automatically merge minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Never automerge major updates (e.g. v1.0 -> v2.0)",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}

{
  "routes": [
    {
      "name": "led-matrix-image",
      "paths": [
        "services/led-matrix/"
      ],
      "operations": [
        "matrix-publish"
      ],
      "auto": true
    },
    {
      "name": "bus-display-image",
      "paths": [
        "services/bus-display/"
      ],
      "operations": [
        "bus-display-publish"
      ],
      "auto": true
    },
    {
      "name": "lidarr-extended-image",
      "paths": [
        "services/lidarr-extended/"
      ],
      "operations": [
        "lidarr-extended-publish"
      ],
      "auto": true
    },
    {
      "name": "voice-asr-image",
      "paths": [
        "services/voice-supply/"
      ],
      "operations": [
        "native-asr-publish"
      ],
      "auto": true
    },
    {
      "name": "home-assistant",
      "paths": [
        "home-assistant/"
      ],
      "operations": [
        "deploy-home-assistant-dry-run",
        "deploy-home-assistant"
      ],
      "auto": true
    },
    {
      "name": "opnsense",
      "paths": [
        "inventory/",
        "tofu/opnsense/",
        "opnsense_reconciler/"
      ],
      "operations": [
        "opnsense-plan",
        "opnsense-apply"
      ],
      "auto": true
    },
    {
      "name": "cloudflare",
      "paths": [
        "tofu/cloudflare/",
        "gitops/cloudflare/ingress-config.yaml"
      ],
      "operations": [
        "cloudflare-plan",
        "cloudflare-apply"
      ],
      "auto": true
    },
    {
      "name": "agent-workspace-host",
      "paths": [
        "flake/modules/agent-workspace",
        "config/agent-workspaces/"
      ],
      "operations": [
        "deploy-agent-workspace-host-dry-run",
        "deploy-agent-workspace-host"
      ],
      "auto": true
    },
    {
      "name": "fleet",
      "paths": [
        "inventory/",
        "flake/hosts/",
        "flake/modules/",
        "flake/flake.nix",
        "flake/flake.lock"
      ],
      "operations": [
        "deploy-fleet-dry-run",
        "deploy-fleet"
      ],
      "auto": true
    },
    {
      "name": "ci-host",
      "paths": [
        "scripts/ci/policy.py",
        "scripts/ci/deployment_risk.py",
        "scripts/ci/applications.py",
        "scripts/ci/development_projects.py",
        "config/ci/operations.json",
        "config/ci/applications.json",
        "config/ci/projects.json",
        "flake/modules/woodpecker.nix",
        "flake/modules/approvals.nix",
        "scripts/approvals/",
        "scripts/verifier/",
        "flake/modules/merge-policy.nix",
        "flake/hosts/homelab-04/",
        "config/projectctl/",
        "flake/profiles/projectctl-pilot.nix",
        "scripts/projectctl/",
        "flake/modules/projectctl.nix",
        "config/ci/projectctl-contracts.json"
      ],
      "operations": [
        "deploy-ci-host-dry-run",
        "deploy-ci-host"
      ],
      "auto": true
    }
  ]
}

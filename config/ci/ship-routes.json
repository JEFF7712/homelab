{
  "routes": [
    {
      "name": "led-matrix-image",
      "paths": ["services/led-matrix/"],
      "operations": ["matrix-publish"],
      "auto": true
    },
    {
      "name": "home-assistant",
      "paths": ["home-assistant/"],
      "operations": ["deploy-home-assistant-dry-run", "deploy-home-assistant"],
      "auto": true
    },
    {
      "name": "opnsense",
      "paths": ["tofu/opnsense/", "opnsense_reconciler/"],
      "operations": ["opnsense-plan", "opnsense-apply"],
      "auto": false
    },
    {
      "name": "cloudflare",
      "paths": ["tofu/cloudflare/"],
      "operations": ["cloudflare-plan", "cloudflare-apply"],
      "auto": false
    },
    {
      "name": "agent-workspace-host",
      "paths": ["flake/modules/agent-workspace", "config/agent-workspaces/"],
      "operations": [
        "deploy-agent-workspace-host-dry-run",
        "deploy-agent-workspace-host"
      ],
      "auto": false
    },
    {
      "name": "fleet",
      "paths": ["flake/hosts/", "flake/modules/", "flake/flake.nix", "flake/flake.lock"],
      "operations": ["deploy-fleet-dry-run", "deploy-fleet"],
      "auto": false
    }
  ]
}

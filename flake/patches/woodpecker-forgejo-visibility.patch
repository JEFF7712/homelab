--- /dev/null
+++ b/server/forge/gitea/homelab_visibility_test.go
@@ -0,0 +1,33 @@
+package gitea
+
+import (
+	"testing"
+
+	"code.gitea.io/sdk/gitea"
+	"github.com/stretchr/testify/require"
+
+	"go.woodpecker-ci.org/woodpecker/v3/server/model"
+)
+
+func TestForgejoVisibilityReconciliation(t *testing.T) {
+	from := &gitea.Repository{
+		FullName: "owner/site",
+		HTMLURL: "https://git.example.invalid/owner/site",
+		Owner: &gitea.User{UserName: "owner", Visibility: gitea.VisibleTypePublic},
+	}
+	current := &model.Repo{Visibility: model.VisibilityPublic}
+	for _, private := range []bool{true, false} {
+		from.Private = private
+		current.Update(toRepo(from))
+		require.Equal(t, private, current.IsSCMPrivate)
+		if private {
+			require.Equal(t, model.VisibilityPrivate, current.Visibility)
+		} else {
+			require.Equal(t, model.VisibilityPublic, current.Visibility)
+		}
+	}
+	from.Owner.Visibility = gitea.VisibleTypePrivate
+	current.Update(toRepo(from))
+	require.True(t, current.IsSCMPrivate)
+	require.Equal(t, model.VisibilityPrivate, current.Visibility)
+}

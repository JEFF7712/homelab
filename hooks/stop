#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=hooks/common.sh
source "$(dirname "$0")/common.sh"
hook_load || hook_ok
cd "$REPO_ROOT"
attention=$(AGENT_HOOK_ACTIVE=1 timeout 6 python -m scripts.agent.hook_runtime stop 2>/dev/null) || hook_ok
ids=$(jq -r 'join(" ")' <<<"$attention" 2>/dev/null) || hook_ok
[[ -n $ids ]] || hook_ok
message="Tasks with checkout drift or unresolved validation: $ids. Resolve failures and run just task-checkpoint <id> before handoff."
event=$(hook_event) || hook_ok
hook_trace reminder
if [[ ${event,,} == stop ]] && jq -e 'has("stop_hook_active") or has("transcript_path") or has("session_id")' >/dev/null 2>&1 <<<"$HOOK_INPUT"; then
  jq -n --arg value "$message" '{systemMessage:$value}' || hook_ok
else
  jq -n --arg value "$message" '{followup_message:$value}' || hook_ok
fi

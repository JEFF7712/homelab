{
  "env": {
    "vars": {
      "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
      "GATEWAY_TOKEN": "${GATEWAY_TOKEN}"
    }
  },
  "auth": {
    "profiles": { "anthropic:default": { "provider": "anthropic", "mode": "api_key" } },
    "order": { 
      "google-antigravity": ["google-antigravity:rupanpandyan@gmail.com"],
      "anthropic": ["anthropic:default"] 
    }
  },
  "agents": {
    "defaults": {
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      },
      "workspace": "/home/node/.openclaw/agents/main/workspace",
      "model": { 
        "primary": "google-antigravity/claude-sonnet-4-5", 
        "fallbacks": [ 
          "google-antigravity/gemini-3-pro-high",
          "anthropic/claude-sonnet-4-5"
       ] 
      },
      "sandbox": { 
        "mode": "non-main", 
        "workspaceRoot": "/tmp/sandboxes" 
      }
    },
    "list": [
      { "id": "main", 
      "identity": { 
        "name": "KubeClaw", 
        "theme": "helpful assistant", 
        "emoji": "🦀" } 
      }
    ]
  },
  "channels": {
    "telegram": {
        "enabled": true,
        "botToken": "${TELEGRAM_BOT_TOKEN}",
        "allowFrom": ["7542293680"],
        "groups": { "*": { "requireMention": true } }
      }
    },
  "logging": {
    "level": "info",
    "file": "/home/node/.openclaw/audit.log",
    "consoleStyle": "json"
  },
  "session": {
    "scope": "per-sender",
    "store": "/home/node/.openclaw/sessions/sessions.json",
    "reset": { "mode": "idle", "idleMinutes": 240 }
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "trustedProxies": ["127.0.0.1", "::1", "10.0.0.0/8"], 
    "controlUi": { 
      "enabled": true, 
      "basePath": "/",
      "allowInsecureAuth": true 
    },
    "auth": { 
      "mode": "token", 
      "token": "${GATEWAY_TOKEN}" 
    }
  },
  "plugins": {
    "entries": {
      "google-antigravity-auth": {
        "enabled": true
      }
    }
  },
  "tools": { 
    "allow": ["exec", "read", "write", "http"]
  }
}

  "resource": {
    "opnsense_firewall_alias": [
      {
        "managed": {
          "content": "${each.value.content}",
          "description": "${each.value.description}",
          "enabled": "${each.value.enabled}",
          "for_each": "${local.firewall_aliases}",
          "name": "${each.value.name}",
          "type": "${each.value.type}"
        }
      }
    ],
    "opnsense_firewall_filter": [
      {
        "managed": {
          "depends_on": [
            "opnsense_firewall_alias.managed"
          ],
          "description": "${each.value.description}",
          "enabled": "${each.value.enabled}",
          "filter": {
            "action": "${each.value.filter.action}",
            "destination": {
              "net": "${each.value.filter.destination.net}",
              "port": "${each.value.filter.destination.port}"
            },
            "direction": "${each.value.filter.direction}",
            "ip_protocol": "${each.value.filter.ip_protocol}",
            "log": "${each.value.filter.log}",
            "protocol": "${each.value.filter.protocol}",
            "quick": "${each.value.filter.quick}",
            "source": {
              "net": "${each.value.filter.source.net}",
              "port": "${each.value.filter.source.port}"
            }
          },
          "for_each": "${local.firewall_filters}",
          "interface": {
            "interface": "${each.value.interface.interface}"
          },
          "sequence": "${each.value.sequence}"
        }
      }
    ],
    "opnsense_firewall_nat_port_forward": [
      {
        "managed": {
          "description": "${each.value.description}",
          "destination": {
            "net": "${each.value.destination.net}",
            "port": "${each.value.destination.port}"
          },
          "enabled": "${each.value.enabled}",
          "for_each": "${local.firewall_nat_port_forwards}",
          "interface": "${each.value.interface}",
          "ip_protocol": "${each.value.ip_protocol}",
          "log": "${each.value.log}",
          "nat_reflection": "${each.value.nat_reflection}",
          "protocol": "${each.value.protocol}",
          "sequence": "${each.value.sequence}",
          "source": {
            "net": "${each.value.source.net}",
            "port": "${each.value.source.port}"
          },
          "target": {
            "ip": "${each.value.target.ip}",
            "port": "${each.value.target.port}"
          }
        }
      }
    ],
    "opnsense_interfaces_vlan": [
      {
        "managed": {
          "description": "${each.value.description}",
          "for_each": "${local.vlans}",
          "lifecycle": {
            "ignore_changes": [
              "device"
            ]
          },
          "parent": "${each.value.parent}",
          "tag": "${each.value.tag}"
        }
      }
    ],
    "opnsense_kea_dhcpv4_reservation": [
      {
        "managed": {
          "description": "${each.value.description}",
          "for_each": "${local.dhcpv4_reservations}",
          "hostname": "${each.value.hostname}",
          "ip_address": "${each.value.ip_address}",
          "mac_address": "${each.value.mac_address}",
          "subnet_id": "${each.value.subnet_id}"
        }
      }
    ],
    "opnsense_kea_dhcpv4_subnet": [
      {
        "managed": {
          "auto_collect": false,
          "description": "${each.value.description}",
          "dns_servers": "${each.value.dns_servers}",
          "for_each": "${local.dhcpv4_subnets}",
          "pools": "${each.value.pools}",
          "routers": "${each.value.routers}",
          "subnet": "${each.value.subnet}"
        }
      }
    ]
  }
}
